VITE_DEPLOYMENT_TARGET=netlify
VITE_MEDUSA_BACKEND_URL=http://localhost:9000
VITE_MEDUSA_PUBLISHABLE_KEY=pk_58d7f2d98973e0ff451fd9d9862d94ef35682526c103b450dfd0d24c6a172916

# For development
VITE_PORT=5176
VITE_HMR_PORT=24677

# Public storefront origin used for canonical URLs, sitemap and agent files (defaults to the request origin)
VITE_STOREFRONT_URL=

# Country the storefront redirects / to when no country cookie is set (defaults to "us", then the first region)
VITE_DEFAULT_COUNTRY_CODE=us

# Medusa Payments publishable key (optional, set automatically on Medusa Cloud)
VITE_MEDUSA_PAYMENTS_PUBLISHABLE_KEY=

# Adyen client key, when taking payments with Adyen (optional). Add the storefront's URL to the
# client key's allowed origins in the Adyen Customer Area.
VITE_ADYEN_CLIENT_KEY=

# Adyen environment, test or live (optional, only if using Adyen)
VITE_ADYEN_ENVIRONMENT=test
